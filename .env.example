# Zenodo API
# Optional: leave empty to make anonymous requests
ZENODO_API_TOKEN=
ZENODO_API_URL=https://zenodo.org/api
ZENODO_SANDBOX=false

# HTTP service (mcp_api only)
HOST=127.0.0.1
PORT=8000
# Required to serve anything but this machine, e.g. the output of `openssl rand -hex 32`
MCP_API_KEY=
# Comma-separated browser origins allowed to call the service
CORS_ORIGINS=
